# Plantilla de configuracion. NO poner secretos reales en este archivo.
#
# Uso:
#   Copy-Item .env.example .env            (o: cp .env.example .env)
#   .\.venv\Scripts\python.exe -m scripts.configurar_desarrollo
#
# El configurador rellena con contrasenas aleatorias y DSN coherentes solo las variables
# vacias; nunca sobrescribe un valor existente. Tambien funciona sin copiar esta plantilla.
# .env esta en .gitignore y en .dockerignore.

# --- Aplicacion -------------------------------------------------------------------------
HISTORIALES_APP_NAME="Red de historiales clinicos"
HISTORIALES_ENVIRONMENT=desarrollo
# Crea las cuentas demo que falten y muestra los accesos al iniciar la API.
HISTORIALES_CUENTAS_DEMO=true
HISTORIALES_API_PREFIX=/api/v1
# Lista JSON de origenes permitidos. Vacia = sin acceso desde otros origenes.
HISTORIALES_CORS_ORIGINS=[]
HISTORIALES_LOG_LEVEL=INFO
HISTORIALES_ACCESS_TOKEN_MINUTES=30
# Zona horaria de la agenda de citas (dia local de cada cita).
HISTORIALES_ZONA_HORARIA=America/Guatemala

# --- Puertos publicados en 127.0.0.1 por docker compose ---------------------------------
POSTGRES_PORT=5434
MYSQL_PORT=3307
MONGO_PORT=27018
API_PORT=8000

# --- Contrasenas de los contenedores (las genera el configurador) -----------------------
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
# Firma de los JWT; minimo 32 bytes.
HISTORIALES_JWT_SECRET=

# --- Conexiones de la API cuando corre en consola (Uvicorn) -----------------------------
# En Docker, compose.yaml las define apuntando a los nombres de servicio; no hace falta
# cambiarlas aqui.
# Hospital General + identidad. Ej.: postgresql://historiales_app:<clave>@127.0.0.1:5434/hospital_general
HISTORIALES_POSTGRES_DSN=
# Solo herramientas administrativas (scripts); NO pasar esta variable a la API.
HISTORIALES_POSTGRES_ADMIN_DSN=
# Centro Pediatrico.
HISTORIALES_MYSQL_HOST=
HISTORIALES_MYSQL_PORT=3307
HISTORIALES_MYSQL_USER=historiales_app
HISTORIALES_MYSQL_PASSWORD=
# Laboratorio Clinico. Ej.: mongodb://historiales_app:<clave>@127.0.0.1:27018/laboratorio_clinico?authSource=laboratorio_clinico
HISTORIALES_MONGODB_URI=

# --- Clinica Odontologica (Cloud Firestore) ---------------------------------------------
# Clave de cuenta de servicio, fuera de Git. Ver .secrets/README.md.
HISTORIALES_FIRESTORE_CREDENTIALS=.secrets/firebase-adminsdk.json
# Opcional: si se omite se usa el project_id que trae la clave.
HISTORIALES_FIRESTORE_PROJECT_ID=
HISTORIALES_FIRESTORE_DATABASE=(default)
